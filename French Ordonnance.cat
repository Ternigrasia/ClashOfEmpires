              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="92ed-1837-6795-d2b2" type="max"/>
              </constraints>
              <rules>
                <rule id="bd7e-ec78-1563-1704" name="Two Handed Weapons" hidden="false">
                  <description>This entitles one half of the front rank attack dice to be with the weapon upgrade. For example, if a unit had 10 attacks, 5 would be with two handed weapons. The player must decide to use this option or not before any dice for combat are rolled.</description>
                </rule>
              </rules>
              <infoLinks>
