              <modifiers>
                <modifier type="increment" field="591f-88f9-ff39-ed8b" value="2.0">
                  <repeats>
                    <repeat field="selections" scope="424f-bed1-9acb-595f" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="9247-6811-b276-e3da" repeats="1" roundUp="false"/>
