    <selectionEntry id="daee-86b8-d557-455a" name="Sub-commander" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="de06-e7a6-e3ee-8e86" name="Devotio" hidden="false" typeId="4960-fea1-01bf-3bfc" typeName="Trait">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="daee-86b8-d557-455a" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="d2c5-7d2e-0d9c-b27b" type="equalTo"/>
                    <condition field="selections" scope="daee-86b8-d557-455a" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a1e9-5366-0a31-eeab" type="equalTo"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="Effect" typeId="0b7e-cba0-4b18-27b9">
DEVOTIO: Adds +1 to ATTACKS (for a total of +3) but deducts 5cm from maximum command range. Must remain with a unit for the entire battle and may not leave it. However, he is killed in combat on a 5 or 6 instead of a 6.</characteristic>
          </characteristics>
        </profile>
